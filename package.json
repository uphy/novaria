{
  "name": "novaria",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port ${DEV_PORT:-5173}",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port ${PREVIEW_PORT:-4173}",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "sim": "tsx tools/sim.ts",
    "ranking": "tsx tools/ranking-admin.ts",
    "icons": "node tools/make-icons.mjs",
    "check:names": "node tools/check-names.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "dev:api": "pnpm build && wrangler d1 migrations apply SCORES_DB --local && wrangler dev --port ${API_PORT:-8788}",
    "e2e:api": "playwright test -c playwright.api.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.4",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.135.0"
  }
}
